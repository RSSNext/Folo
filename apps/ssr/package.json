    "@types/html-minifier-terser": "7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "chokidar": "5.0.0",
    "code-inspector-plugin": "2.0.9",
    "daisyui": "5.7.43",
    "dotenv-flow": "4.1.0",
    "es-toolkit": "1.52.0",
    "fast-glob": "3.3.3",
    "foxact": "0.3.12",
