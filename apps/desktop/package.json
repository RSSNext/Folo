{
  "name": "Folo",
  "type": "module",
  "version": "1.12.0",
  "private": true,
  "description": "Follow everything in one place",
  "author": "Folo Team",
  "homepage": "https://github.com/RSSNext",
  "repository": {
    "url": "https://github.com/RSSNext/Folo",
    "type": "git"
  },
  "main": "./dist/main/index.js",
  "scripts": {
    "analyze:web": "cross-env analyzer=1 WEB_BUILD=1 vite build",
    "apply:release-config": "tsx scripts/apply-release-config.ts",
    "build:electron": "pnpm run build:electron-vite && electron-forge make",
    "build:electron-forge": "electron-forge make",
    "build:electron-forge:macos": "electron-forge make --arch=x64 --platform=darwin && electron-forge make --arch=arm64 --platform=darwin && tsx scripts/merge-yml.ts",
    "build:electron-forge:mas": "electron-forge make --arch=universal --platform=mas",
    "build:electron-forge:ms": "tsx scripts/generate-appx-manifest.ts && electron-forge make --platform=win32 --ms=true",
    "build:electron-vite": "electron-vite build",
    "build:render": "vite build -c vite.config.electron-render.ts",
    "build:web": "rm -rf out/web && cross-env WEB_BUILD=1 vite build",
    "bump": "vv --minor",
    "dedupe:locales": "eslint --fix locales/**/*.json",
    "depcheck": "npx depcheck --quiet",
    "dev": "turbo run @follow/web#dev @follow/ssr#dev",
    "dev:debug": "export DEBUG=true && vite --debug",
    "dev:electron": "electron-vite dev",
    "dev:server": "pnpm run --filter=ssr dev",
    "dev:web": "cross-env WEB_BUILD=1 vite",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:electron": "playwright test -c e2e/playwright.config.ts --project=electron",
    "e2e:electron:prod": "cross-env FOLO_E2E_PROFILE=prod playwright test -c e2e/playwright.config.ts --project=electron",
    "e2e:install": "playwright install chromium",
    "e2e:web": "playwright test -c e2e/playwright.config.ts --project=web",
    "e2e:web:prod": "cross-env FOLO_E2E_PROFILE=prod playwright test -c e2e/playwright.config.ts --project=web",
    "hotfix": "vv -c bump.hotfix.config.js --patch",
    "publish": "electron-vite build && electron-forge publish",
    "start": "electron-vite preview",
    "update:main-hash": "tsx plugins/vite/generate-main-hash.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-appx": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-pkg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@follow/components": "workspace:*",
    "@follow/configs": "workspace:*",
    "@follow/constants": "workspace:*",
    "@follow/hooks": "workspace:*",
    "@follow/models": "workspace:*",
    "@follow/shared": "workspace:*",
    "@follow/utils": "workspace:*",
    "@pengx17/electron-forge-maker-appimage": "1.2.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/html-minifier-terser": "7.0.2",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-legacy": "7.2.1",
    "@vitejs/plugin-react": "5.1.4",
    "async-es": "3.2.6",
    "autoprefixer": "10.5.2",
    "bufferutil": "4.1.0",
    "code-inspector-plugin": "1.6.6",
    "cssnano": "8.0.2",
    "drizzle-orm": "0.45.2",
    "electron": "43.1.0",
    "electron-devtools-installer": "4.0.0",
    "electron-packager-languages": "0.6.0",
    "electron-vite": "5.0.0",
    "es-toolkit": "1.49.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.10.6",
    "html-minifier-terser": "7.2.0",
    "js-yaml": "5.2.1",
    "kolorist": "1.8.0",
    "nbump": "2.1.8",
    "pathe": "2.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "semver": "7.8.5",
    "tailwindcss": "4.3.2",
    "tailwindcss-content-visibility": "1.0.3",
    "tailwindcss-multi": "0.4.6",
    "tar": "7.5.19",
    "unplugin-ast": "0.17.2",
    "vite-bundle-analyzer": "1.3.8",
    "vite-plugin-mkcert": "2.1.0",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-route-builder": "0.4.1",
    "vite-tsconfig-paths": "6.1.1",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "runtimeVersion": "1.12.0",
  "productName": "Folo",
  "mainHash": "0fdc4db0cd19e2c2d6cf6c596aa1a62cc253b4c9612633470cb6b8d64fba403a"
}
