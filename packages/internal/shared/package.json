{
  "name": "@follow/shared",
  "type": "module",
  "private": true,
  "author": "Folo Team",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/RSSNext",
  "repository": {
    "url": "https://github.com/RSSNext/follow",
    "type": "git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "require": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./interface/*": {
      "types": "./src/interface/*.ts",
      "require": "./src/interface/*.ts",
      "import": "./src/interface/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/stripe": "1.7.5",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@follow-app/client-sdk": "catalog:",
    "@folo-services/drizzle": "0.1.47",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "sonner": "2.0.8",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  }
}
